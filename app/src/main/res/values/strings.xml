    <string name="shield_section_title">Wake Shield</string>
    <string name="shield_master_title">Wake Shield</string>
    <string name="shield_master_summary">Opt-in firewall: after a short grace, cancel wake notifications, lock, and (with root) sleep/deny holders. Not a guarantee — screen may flash. Alarms and calls are best-effort exempt.</string>
    <string name="shield_forensics_title">Wake forensics</string>
    <string name="shield_forensics_summary">Log active notification packages and shield outcomes even when Shield is off</string>
    <string name="shield_root_kill_title">Kill / deny wake holders (root)</string>
    <string name="shield_root_kill_summary">After detect: KEYCODE_SLEEP and optional TURN_SCREEN_ON appops deny. Confirm carefully — denies stick until undone.</string>
    <string name="shield_root_kill_confirm_title">Enable root wake deny?</string>
    <string name="shield_root_kill_confirm_body">This can set TURN_SCREEN_ON ignore on identified packages. Use Panic disable or the undo list to restore.</string>
